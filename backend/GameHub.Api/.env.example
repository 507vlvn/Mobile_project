# Mẫu cấu hình bí mật của backend. Sao chép thành `.env` (cùng thư mục) rồi điền giá trị thật.
# File `.env` KHÔNG được commit. Biến môi trường thật (nếu có) được ưu tiên hơn file này.
ConnectionStrings__DefaultConnection=Server=YOUR_SERVER;Database=doan_mobile;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Max Pool Size=10
Jwt__Key=CHANGE-ME-random-string-at-least-32-characters
