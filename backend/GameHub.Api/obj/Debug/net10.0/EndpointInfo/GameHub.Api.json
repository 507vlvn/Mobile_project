          "id": {
            "type": "integer",
            "format": "int32"
          },
          "gameCode": {
            "type": "string",
            "nullable": true
          },
          "gameName": {
            "type": "string",
            "nullable": true
          },
          "difficulty": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "challenger": {
            "$ref": "#/components/schemas/ChallengeUserDto"
          },
          "opponent": {
            "$ref": "#/components/schemas/ChallengeUserDto"
          },
          "myResult": {
            "$ref": "#/components/schemas/ChallengeResultDto"
          },
          "theirResult": {
            "$ref": "#/components/schemas/ChallengeResultDto"
          },
          "winnerId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "seed": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ChallengeResultDto": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "timeSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "mistakes": {
            "type": "integer",
            "format": "int32"
          },
          "result": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChallengeUserDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          }
